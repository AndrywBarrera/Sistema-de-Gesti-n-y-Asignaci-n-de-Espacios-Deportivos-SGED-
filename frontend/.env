# ─── SGED · Variables de entorno ─────────────────────────────────────────────
# Copia este archivo como .env.local y ajusta los valores.

# URL base del backend FastAPI
VITE_API_URL=http://localhost:8000/api/v1

# Poner en "true" para usar datos mock sin backend (desarrollo)
# Poner en "false" para conectar con el backend real
VITE_USE_MOCK=false
